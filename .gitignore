# ============================================================
# E-Set Digital Management System
# Files that must not be committed to Git
# ============================================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Build output
dist/
build/
frontend/dist/
backend/dist/
coverage/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / temporary files
tmp/
temp/
*.tmp
*.pid

# Local uploads and evidence
uploads/
backend/uploads/
storage/
local-storage/

# Database dumps / backups
*.sql
*.dump
*.backup
backups/

# OS-generated files
.DS_Store
Thumbs.db

# IDE / editor machine-specific files
.vscode/
.idea/

# Local certificates and keys
*.pem
*.key
*.p12
*.pfx

# Test artifacts
playwright-report/
test-results/

# Cache files
.cache/
.eslintcache
.vite/