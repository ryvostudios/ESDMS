NODE_ENV=development
# Address to bind the HTTP server to. Defaults to 127.0.0.1 in development
# and 0.0.0.0 in production if unset — Render (and most PaaS platforms)
# route public traffic to the container over its internal network, and a
# server bound only to 127.0.0.1 is unreachable from outside the container.
# Usually left unset; only set explicitly to override the default.
HOST=
PORT=3000
# The role the running API process connects as day-to-day — restricted to
# SELECT/INSERT/UPDATE/DELETE in production (see scripts/provision-db-roles.sql
# and docs/SECURITY.md §8.2). Locally this can be a full-privilege dev role;
# in production it must NOT be the schema owner.
DATABASE_URL=postgresql://localhost:5432/eset_dev
# An elevated/owner-role connection string, used ONLY by
# `npm run migrate:up:prod` to apply schema migrations — never by the
# running app. Leave unset in development (migrate:up falls back to
# DATABASE_URL, which is fine locally since there's only one role). Set
# this in production to a role that owns the schema; DATABASE_URL there
# stays the restricted runtime role above.
MIGRATION_DATABASE_URL=
JWT_SECRET=replace-with-a-random-64-byte-hex-string-min-32-chars
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173
# Base URL embedded in every Gate Pass QR code as a deep link. Must be
# https:// in production (enforced at startup). Defaults to the first
# FRONTEND_ORIGIN when unset.
APP_PUBLIC_URL=
# IANA timezone the business operates in. Used for anything date-numbering
# or display sensitive (gate pass number year, printed PDF dates) so it
# stays correct regardless of the host machine's own local timezone.
# Stored timestamps remain UTC/timestamptz either way.
APP_TIMEZONE=Asia/Karachi
# "local" (disk under STORAGE_DIR — development/test/demo only) or
# "supabase" (private bucket — required in production; see
# shared/storage/storage-service.js and docs/SECURITY.md). Production
# refuses to start with STORAGE_PROVIDER=local.
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
# Required when STORAGE_PROVIDER=supabase. SUPABASE_SERVICE_ROLE_KEY is a
# secret — never expose it to the frontend, never commit a real value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Number of trusted reverse-proxy hops in front of this server (e.g. 1 on
# Render's default setup). 0 = no proxy, trust the raw socket address only.
# Required to be set explicitly in production (no default there) — see
# docs/SECURITY.md.
TRUST_PROXY_HOPS=0
# Leave unset unless the deployed frontend and API are on different
# subdomains of the same registrable domain and need to share the cookie.
COOKIE_DOMAIN=
