NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://localhost:5432/eset_dev
# Set only in production, to a separate least-privilege runtime role —
# see docs/DECISIONS.md and docs/SECURITY.md for the required grants.
# Falls back to DATABASE_URL when unset (dev convenience only).
MIGRATION_DATABASE_URL=
JWT_SECRET=replace-with-a-random-64-byte-hex-string-min-32-chars
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage
# Number of trusted reverse-proxy hops in front of this server (e.g. 1 on
# Render's default setup). 0 = no proxy, trust the raw socket address only.
TRUST_PROXY_HOPS=0
# Leave unset unless the deployed frontend and API are on different
# subdomains of the same registrable domain and need to share the cookie.
COOKIE_DOMAIN=
