{
  "name": "backend",
  "version": "1.0.0",
  "description": "E-Set Digital Management System Backend API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate:up": "node-pg-migrate up",
    "db:release": "node scripts/release-db.js",
    "db:verify-runtime": "node scripts/verify-runtime-db.js",
    "reset:operational-data": "node scripts/reset-operational-data.js",
    "migrate:down": "node-pg-migrate down",
    "migrate:up:prod": "node-pg-migrate up -d MIGRATION_DATABASE_URL",
    "db:release": "node scripts/release-database.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "user:create-admin": "node scripts/create-admin-user.js",
    "user:create-ceo": "node scripts/create-ceo-user.js",
    "test": "DOTENV_CONFIG_PATH=.env.test node scripts/run-tests-with-disposable-db.js",
    "test:provided": "ESDMS_TEST_DATABASE_MODE=provided DOTENV_CONFIG_PATH=.env.test node scripts/run-tests-with-disposable-db.js"
  },
  "private": true,
  "dependencies": {
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "tldts": "^7.4.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
