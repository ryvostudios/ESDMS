VITE_API_URL=http://localhost:3000/api/v1
# Non-secret source/build identifier shown only on the diagnostics screen.
VITE_BUILD_REVISION=development
# Business timezone for displaying operational timestamps (approval,
# departure, return, audit log). Must match the backend's APP_TIMEZONE
# (see backend/.env.example) — duplicated here rather than fetched from
# the API because it's build-time and non-sensitive.
VITE_APP_TIMEZONE=Asia/Karachi
